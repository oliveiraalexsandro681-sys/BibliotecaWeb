
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Biblioteca WEB</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BibliotecaWeb.styles.css" asp-append-version="true" />
</head>
<body>

   <header>
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">

            <!-- Abaixo esta a nossa LOGO -->
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                📚 BibliotecaWeb
            </a>

            <!-- Abaixo esta o nosso botão do MOBILE -->
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#menuNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!--Abaixo esta o nosso  MENU -->
            <div class="collapse navbar-collapse" id="menuNavbar">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">
                            Início
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Livros"
                           asp-action="Index">
                            Catálogo
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Admin"
                           asp-action="Index">
                            Aréa Restrita
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            Revistas
                        </a>
                    </li>

                </ul>

            </div>

        </div>
    </nav>
</header>


    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
