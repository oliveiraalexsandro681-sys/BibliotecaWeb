@model BibliotecaWeb.Models.BuscaLivrosViewModel

@{
    ViewData["Title"] = "Buscar obras";
}

<div class="container mt-4">

    <!-- TÍTULO -->

    <div class="mb-4">

        <h2>Buscar obras</h2>

        <p class="text-muted">
            Pesquise livros na Open Library.
        </p>

    </div>


    <!-- CAMPO DE BUSCA -->

    <form method="get"
          asp-controller="Livros"
          asp-action="BuscaExterna"
          class="mb-5">

        <div class="input-group">

            <input type="text"
                   name="busca"
                   value="@Model.Busca"
                   class="form-control"
                   placeholder="Digite o nome do livro..." />

            <button type="submit"
                    class="btn btn-primary">

                Buscar

            </button>

        </div>

    </form>


    <!-- RESULTADOS -->

    @if (Model.Livros.Any())
    {
        <div class="row">

            @foreach (var livro in Model.Livros)
            {
                <div class="col-lg-3 col-md-4 col-sm-6 mb-4">

                    <div class="card h-100 shadow-sm">


                        <!-- CAPA -->

                        @if (livro.CapaId != null)
                        {
                            <div style="
                                height: 350px;
                                background-color: #f5f5f5;
                                display: flex;
                                align-items: center;
                                justify-content: center;
                                overflow: hidden;
                            ">

                                <img src="https://covers.openlibrary.org/b/id/@(livro.CapaId)-M.jpg"
                                     alt="Capa de @livro.Titulo"
                                     style="
                                        width: 100%;
                                        height: 100%;
                                        object-fit: contain;
                                     " />

                            </div>
                        }
                        else
                        {
                            <div style="
                                height: 350px;
                                background-color: #f5f5f5;
                                display: flex;
                                align-items: center;
                                justify-content: center;
                            ">

                                <span class="text-muted">
                                    Capa não disponível
                                </span>

                            </div>
                        }


                        <!-- INFORMAÇÕES -->

                        <div class="card-body d-flex flex-column">

                            <h5 class="card-title">
                                @livro.Titulo
                            </h5>


                            <!-- AUTOR -->

                            <p class="card-text mb-2">

                                <strong>Autor:</strong>

                                @if (livro.Autores.Any())
                                {
                                    @string.Join(", ", livro.Autores)
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Não informado
                                    </span>
                                }

                            </p>


                            <!-- ANO -->

                            <p class="card-text mb-2">

                                <strong>Ano de publicação:</strong>

                                @(livro.AnoPublicacao?.ToString() ?? "Não informado")

                            </p>


                            <!-- FONTE -->

                            <p class="card-text">

                                <strong>Fonte:</strong>

                                Open Library

                            </p>


                            <!-- BOTÃO -->

                            <div class="mt-auto pt-3">

                                <button type="button"
                                        class="btn btn-primary w-100 btn-detalhes"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalDetalhes"
                                        data-titulo="@livro.Titulo"
                                        data-autor="@string.Join(", ", livro.Autores)"
                                        data-ano="@(livro.AnoPublicacao?.ToString() ?? "Não informado")"
                                        data-capa="@(livro.CapaId != null ? $"https://covers.openlibrary.org/b/id/{livro.CapaId}-L.jpg" : "")">

                                    Ver detalhes

                                </button>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }


    <!-- NENHUM RESULTADO -->

    @if (!Model.Livros.Any() && !string.IsNullOrWhiteSpace(Model.Busca))
    {
        <div class="alert alert-warning">

            Nenhuma obra encontrada para:

            <strong>@Model.Busca</strong>

        </div>
    }

</div>


<!-- ===================================================== -->
<!-- MODAL DE DETALHES -->
<!-- ===================================================== -->

<div class="modal fade"
     id="modalDetalhes"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">


            <!-- CABEÇALHO -->

            <div class="modal-header">

                <h5 class="modal-title">
                    Detalhes da obra
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Fechar">
                </button>

            </div>


            <!-- CORPO -->

            <div class="modal-body">

                <div class="row">


                    <!-- CAPA -->

                    <div class="col-md-4 text-center">

                        <img id="modalCapa"
                             src=""
                             alt="Capa da obra"
                             class="img-fluid rounded"
                             style="
                                max-height: 450px;
                                object-fit: contain;
                             " />

                    </div>


                    <!-- INFORMAÇÕES -->

                    <div class="col-md-8">

                        <h3 id="modalTitulo">
                        </h3>


                        <p>

                            <strong>Autor:</strong>

                            <span id="modalAutor">
                            </span>

                        </p>


                        <p>

                            <strong>Ano de publicação:</strong>

                            <span id="modalAno">
                            </span>

                        </p>


                        <p>

                            <strong>Fonte:</strong>

                            Open Library

                        </p>

                    </div>

                </div>

            </div>


            <!-- RODAPÉ -->

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-primary"
                        data-bs-dismiss="modal">

                    Fechar

                </button>

            </div>


        </div>

    </div>

</div>


<!-- ===================================================== -->
<!-- JAVASCRIPT DO MODAL -->
<!-- ===================================================== -->

<script>

    document.querySelectorAll(".btn-detalhes").forEach(function (botao) {

        botao.addEventListener("click", function () {

            // Pegamos os dados do botão clicado

            const titulo = this.dataset.titulo;

            const autor = this.dataset.autor;

            const ano = this.dataset.ano;

            const capa = this.dataset.capa;


            // Colocamos os dados dentro do modal

            document.getElementById("modalTitulo").textContent = titulo;

            document.getElementById("modalAutor").textContent =
                autor || "Não informado";

            document.getElementById("modalAno").textContent =
                ano;


            // Pegamos a imagem do modal

            const imagem = document.getElementById("modalCapa");


            // Verificamos se existe capa

            if (capa) {

                imagem.src = capa;

                imagem.style.display = "block";

            }
            else {

                imagem.style.display = "none";

            }

        });

    });

</script>