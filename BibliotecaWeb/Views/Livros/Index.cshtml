@{
   //@model BibliotecaWeb.Models.Livro;
  //acima estamos fazendo o seguinte : chamando nossa classe criada, e junto com ela os objetos que criamos.
  //para chamar ela, colocamos o codigo acima e e logo em seguida no HTML colocamos : @Model.Titulo (ou o objeto criado a partir da classe)
}

@model List<BibliotecaWeb.Models.Obra>
 <!--Acima estamos utilizando o @@model List<> para mostrar a lista de livros que criamos-->
	
	 <div class="text-center mb-4">
		 <span class="catalogo-tag">📚 NOSSO CATÁLOGO </span>
		 <h1 class="catalogo-titulo"></h1>
		 <p class="catalogo-descricao">
			 Encontre Livros, HQs, mangás e revistas para todos os gostos.
		 </p>

		 <form asp-controller="Livros"
			   asp-action="Index"
			   method="get">

			 <div class="buscador-catalogo">

				 <div class="campo-busca-catalogo">

					 <span>🔍</span>

					 <input type="text"
							name="busca"
							value="@ViewBag.BuscaAtual"
							id="buscador"
							placeholder="Pesquise por livros, HQs e mangás...."/>

				 </div>

				 <button type="submit"
						 class="btn-buscar-catalogo">

					 Buscar

				 </button>

			 </div>

		 </form>


		 <div id="mensagemVazia"
			  class="alert alert-warning text-center d-none"
			  role="alert">

			 Nenhum livro encontrado com esse nome.

		 </div>

	 </div>


	 <div class="container">

		 <!-- ===================================================== -->
		 <!-- RESULTADOS DO NOSSO BANCO -->
		 <!-- ===================================================== -->

		 @if (!string.IsNullOrEmpty(ViewBag.BuscaAtual as string))
		 {
			 <h2 class="mb-4">
				 📚 Resultados do nosso catálogo
			 </h2>
		 }

		 <div class="row row-cols-1 row-cols-md-5 g-4">

			@foreach (var livro in Model)
			{
				<div class="col card-livro"
					 data-titulo="@livro.Titulo" >

					<div class="card card-biblioteca h-100">

						<img src="@livro.FotoUrl"
							 class="card-img-top imagem-livro"
							 alt="@livro.Titulo" />

						<!--Acima estamos criando uma classe card-h100, ou seja estamos criando nosso card
						e dentro dele temos a nossa imagem @@livro.FotoUrl...
						class="card-img-top" significa que a nossa imagem vai ficar no topo do card.
					-->

					<!--<a asp-controller="Livros"
						   asp-action="Detalhes"
						   asp-route-id="@livro.Id"
						   class="btn btn-dark">
							Ver detalhes
						</a>  Aqui é um link para ir para outra pág (detalhes)-->

						<div class="card-body d-flex flex-column justify-content-between">

							<div>

								<span class="categoria-card">
									@livro.Tipo
								</span>

								<h5 class="card-title">
									@livro.Titulo
								</h5>

								<p class="card-text">
									Autor : @livro.Autor
								</p>

							</div>


							<button type="button"
									class="btn btn-dark btn-detalhes mt-2"
									data-bs-toggle="modal"
									data-bs-target="#meuModal"
									data-id="@livro.Id">

								Ver detalhes

							</button>

						</div>

					</div>

				</div>
			}


			<!-- ===================================================== -->
			<!-- MODAL DO NOSSO BANCO -->
			<!-- ===================================================== -->

			<div class="modal" id="meuModal">

				<div class="modal-dialog">

					<div class="modal-content">

						<div class="modal-header">

							<h5 class="modal-title">
								Detalhes
							</h5>

							<button type="button"
									class="btn-close"
									data-bs-dismiss="modal">
							</button>

						</div>


						<div class="modal-body text-center">

							<img src=""
								 id="imagemLivro"
								 class="img-fluid rounded mb-3"
								 style="max-height: 400px;" />

							<h4 id="tituloLivro"></h4>

							<p id="autorLivro"
							   class="text-muted">
							</p>

							<p id="tipoLivro"></p>

							<p id="modalidadeLivro"></p>

							<p id="precoCompraLivro"></p>

							<p id="precoAluguelLivro"></p>

							<p id="plataformaLivro"></p>

						</div>


						<div class="modal-footer">

							<button class="btn btn-secondary"
									data-bs-dismiss="modal">

								Fechar

							</button>

						</div>

					</div>

				</div>

			</div>

		 </div>


		 <!-- ===================================================== -->
		 <!-- RESULTADOS DA OPEN LIBRARY -->
		 <!-- ===================================================== -->

		 @if (!string.IsNullOrEmpty(ViewBag.BuscaAtual as string))
		 {
			 <section class="mt-5">

				 <hr class="mb-5" />

				 <h2 class="mb-4">
					 🌐 Resultados encontrados na Open Library
				 </h2>

				 <div id="resultadosExternos"
					  class="row row-cols-1 row-cols-md-5 g-4">
				 </div>

			 </section>
		 }


		 <!-- ===================================================== -->
		 <!-- MODAL DA OPEN LIBRARY -->
		 <!-- ===================================================== -->

		 <div class="modal fade"
			  id="modalExterno"
			  tabindex="-1"
			  aria-hidden="true">

			 <div class="modal-dialog modal-lg modal-dialog-centered">

				 <div class="modal-content">

					 <div class="modal-header">

						 <h5 class="modal-title">
							 Detalhes
						 </h5>

						 <button type="button"
								 class="btn-close"
								 data-bs-dismiss="modal">
						 </button>

					 </div>


					 <div class="modal-body text-center">

						 <img id="modalExternoCapa"
							  src=""
							  class="img-fluid rounded mb-3"
							  style="max-height: 400px;" />


						 <h4 id="modalExternoTitulo">
						 </h4>


						 <p class="text-muted">

							 Autor:

							 <span id="modalExternoAutor">
							 </span>

						 </p>


						 <p>

							 Ano:

							 <span id="modalExternoAno">
							 </span>

						 </p>


						 <p class="text-muted">

							 Fonte: Open Library

						 </p>

					 </div>


					 <div class="modal-footer">

						 <button class="btn btn-secondary"
								 data-bs-dismiss="modal">

							 Fechar

						 </button>

					 </div>

				 </div>

			 </div>

		 </div>

	</div>


<script>

	// =====================================================
	// OBRAS DO NOSSO BANCO
	// =====================================================

	const livros =
		@Html.Raw(ViewBag.LivrosJson ?? "[]");


	const botoes =
		document.querySelectorAll('.btn-detalhes');


	botoes.forEach(botao => {

		botao.addEventListener('click', function () {

			const id =
				this.getAttribute('data-id');


			const livro =
				livros.find(x =>
					x.Id == id ||
					x.id == id
				);


			if (livro) {

				const titulo =
					document.getElementById(
						'tituloLivro'
					);

				const autor =
					document.getElementById(
						'autorLivro'
					);

				const imagem =
					document.getElementById(
						'imagemLivro'
					);

				const tipo =
					document.getElementById(
						'tipoLivro'
					);

				const modalidade =
					document.getElementById(
						'modalidadeLivro'
					);

				const precoCompra =
					document.getElementById(
						'precoCompraLivro'
					);

				const precoAluguel =
					document.getElementById(
						'precoAluguelLivro'
					);

				const plataforma =
					document.getElementById(
						'plataformaLivro'
					);


				tipo.textContent =
					"Tipo: " +
					(
						livro.Tipo ??
						livro.tipo ??
						""
					);


				modalidade.textContent =
					"Disponibilidade: " +
					(
						livro.Modalidade ??
						livro.modalidade ??
						""
					);


				precoCompra.textContent =
					"Preço de compra: R$ " +
					(
						livro.PrecoCompra ??
						livro.precoCompra ??
						"0,00"
					);


				precoAluguel.textContent =
					"Preço de aluguel: R$ " +
					(
						livro.PrecoAluguel ??
						livro.precoAluguel ??
						"0,00"
					);


				plataforma.textContent =
					"Loja/Plataforma: " +
					(
						livro.LojaOuPlataforma ||
						livro.lojaOuPlataforma ||
						""
					);


				imagem.src =
					livro.FotoUrl ||
					livro.fotoUrl ||
					"";


				titulo.textContent =
					livro.Titulo ||
					livro.titulo ||
					"";


				autor.textContent =
					"Autor: " +
					(
						livro.Autor ||
						livro.autor ||
						""
					);

			}

		});

	});


	// =====================================================
	// BUSCA LOCAL
	// =====================================================

	const buscador =
		document.getElementById('buscador');


	const mensagemVazia =
		document.getElementById('mensagemVazia');


	buscador.addEventListener('input', function () {

		const texto =
			this.value.toLowerCase();


		const cards =
			document.querySelectorAll('.card-livro');


		let encontrouAlgum =
			false; // Variável de controle (bandeira/flag)


		cards.forEach(card => {

			const titulo =
				card
					.getAttribute('data-titulo')
					.toLowerCase();


			if (titulo.includes(texto)) {

				card.style.display =
					''; // Mostra o card

				encontrouAlgum =
					true;   // Marca que pelo menos 1 livro foi achado

			}
			else {

				card.style.display =
					'none'; // Esconde o card

			}

		});


		//Se NÃO encontrou nenhum livro, remove a classe 'd-none' para mostrar o aviso

		if (!encontrouAlgum) {

			mensagemVazia.classList.remove(
				'd-none'
			);

		}
		else {

			mensagemVazia.classList.add(
				'd-none'
			);

		}

	});


	// =====================================================
	// RESULTADOS DA OPEN LIBRARY
	// =====================================================

	const livrosExternos =
		@Html.Raw(ViewBag.LivrosExternosJson ?? "[]");


	console.log(
		"LIVROS RECEBIDOS DA OPEN LIBRARY:"
	);

	console.log(livrosExternos);


	const container =
		document.getElementById(
			"resultadosExternos"
		);


	if (
		container &&
		livrosExternos.length > 0
	) {

		livrosExternos.forEach(livro => {


			// =====================================================
			// DADOS DA OPEN LIBRARY
			// =====================================================

			const titulo =
				livro.title ||
				"Título não informado";


			const autores =
				Array.isArray(
					livro.author_name
				) &&
				livro.author_name.length > 0

					? livro.author_name.join(", ")

					: "Autor não informado";


			const ano =
				livro.first_publish_year ||
				"Ano não informado";


			let capa = "";


			if (livro.cover_i) {

				capa =
					"https://covers.openlibrary.org/b/id/" +
					livro.cover_i +
					"-M.jpg";

			}


			// =====================================================
			// COLUNA
			// =====================================================

			const coluna =
				document.createElement("div");


			coluna.className =
				"col";


			// =====================================================
			// CARD
			// =====================================================

			const card =
				document.createElement("div");


			card.className =
				"card card-biblioteca h-100";


			// =====================================================
			// CAPA
			// =====================================================

			if (capa) {

				const imagem =
					document.createElement("img");


				imagem.src =
					capa;


				imagem.alt =
					"Capa de " +
					titulo;


				imagem.className =
					"card-img-top imagem-livro";


				card.appendChild(
					imagem
				);

			}


			// =====================================================
			// CORPO
			// =====================================================

			const corpo =
				document.createElement("div");


			corpo.className =
				"card-body d-flex flex-column";


			// =====================================================
			// TÍTULO
			// =====================================================

			const tituloElemento =
				document.createElement("h5");


			tituloElemento.className =
				"card-title";


			tituloElemento.textContent =
				titulo;


			// =====================================================
			// AUTOR
			// =====================================================

			const autorElemento =
				document.createElement("p");


			autorElemento.className =
				"card-text text-muted";


			autorElemento.textContent =
				"Autor: " +
				autores;


			// =====================================================
			// ANO
			// =====================================================

			const anoElemento =
				document.createElement("p");


			anoElemento.className =
				"card-text text-muted";


			anoElemento.textContent =
				"Ano: " +
				ano;


			// =====================================================
			// BOTÃO
			// =====================================================

			const botao =
				document.createElement("button");


			botao.type =
				"button";


			botao.className =
				"btn btn-dark w-100 mt-auto";


			botao.textContent =
				"Ver detalhes";


			botao.setAttribute(
				"data-bs-toggle",
				"modal"
			);


			botao.setAttribute(
				"data-bs-target",
				"#modalExterno"
			);


			// =====================================================
			// CLIQUE DO BOTÃO
			// =====================================================

			botao.addEventListener(
				"click",
				function () {

					document.getElementById(
						"modalExternoTitulo"
					).textContent =
						titulo;


					document.getElementById(
						"modalExternoAutor"
					).textContent =
						autores;


					document.getElementById(
						"modalExternoAno"
					).textContent =
						ano;


					const imagemModal =
						document.getElementById(
							"modalExternoCapa"
						);


					if (livro.cover_i) {

						imagemModal.src =
							"https://covers.openlibrary.org/b/id/" +
							livro.cover_i +
							"-L.jpg";


						imagemModal.style.display =
							"block";

					}
					else {

						imagemModal.src =
							"";


						imagemModal.style.display =
							"none";

					}

				}
			);


			// =====================================================
			// MONTA O CARD
			// =====================================================

			corpo.appendChild(
				tituloElemento
			);


			corpo.appendChild(
				autorElemento
			);


			corpo.appendChild(
				anoElemento
			);


			corpo.appendChild(
				botao
			);


			card.appendChild(
				corpo
			);


			coluna.appendChild(
				card
			);


			container.appendChild(
				coluna
			);

		});

	}


</script>

<!-- Acima estamos chamando e mostrando o nosso objeto, utilizando o @@Model e logo em seguida é o nosso objeto criado a partir da classe-->
<!-- Acima estamos chamando a nossa View que declaramos no inicio e ai vai aparecer na view-->